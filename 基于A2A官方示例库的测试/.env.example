# DeepSeek API key used by the host and both agents.
DEEPSEEK_API_KEY="your key"

# Host routing model, using LiteLLM provider format.
LITELLM_MODEL="deepseek/deepseek-chat"

# Python ticket agent DeepSeek model name.
DEEPSEEK_MODEL="deepseek-chat"

# Remote agent endpoints.
WEA_AGENT_URL=http://localhost:10001
TICKET_AGENT_URL=http://localhost:10002

# Optional: JDK 17+ home directory used by scripts\start_all.ps1.
# When unset, start_all.ps1 uses JAVA_HOME from the system or java found on PATH.
# JAVA_HOME="C:\Program Files\Eclipse Adoptium\jdk-17.0.20.8-hotspot"

# A 12306 price query may retry; allow enough time for the remote A2A agent.
REMOTE_AGENT_TIMEOUT_SECONDS=120

# 12306 MCP launch settings.
TICKET_MCP_COMMAND=uvx
TICKET_MCP_ARGS=["mcp-server-12306"]
# Optional: pass environment variables to the 12306 MCP server, e.g. a login cookie.
# TICKET_MCP_ENV_JSON={"12306_COOKIE": ""}